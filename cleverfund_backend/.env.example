# .env.example — copy to .env and fill in your values
# Then load with: export $(cat .env | xargs)   (Linux/Mac)
# Or use python-dotenv in development

# ── Required in production ────────────────────────────────────────────────────
SESSION_SECRET=replace-this-with-a-long-random-string-in-production

# ── Optional overrides ────────────────────────────────────────────────────────
# DB_PATH=data/cleverfund.db
# STARTUP_DATASET_PATH=data/combined_dataset.xlsx
# PORT=5000

MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cleverfund

# OpenAI configuration (optional)
# Set your OpenAI API key here; do NOT commit real keys to source control.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60
